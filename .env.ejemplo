# Configuración de la Plataforma EFA.
#
# Copia este fichero como  backend/.env  y rellena los valores.
# backend/.env está en .gitignore: NUNCA subas tus credenciales al repositorio.

# ---------------------------------------------------------------------------
# 1. Clave de firma de las sesiones  (OBLIGATORIA al desplegar)
# ---------------------------------------------------------------------------
# Firma los tokens de sesión. Si no se define, se genera una efímera y las
# sesiones se pierden en cada reinicio. Genera una así:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
EFA_SECRET_KEY=

# Horas que dura la sesión antes de tener que volver a entrar.
EFA_HORAS_SESION=72

# ---------------------------------------------------------------------------
# 2. Acceso privado  (OBLIGATORIO al desplegar)
# ---------------------------------------------------------------------------
# Lista separada por comas de las cuentas autorizadas: correos (para Google,
# Microsoft o Facebook) y/o nombres de usuario (para el acceso con contraseña).
# Si se deja VACÍO no se restringe el acceso: válido solo en local.
# Ejemplo: EFA_USUARIOS_PERMITIDOS=tucorreo@gmail.com,pablo
EFA_USUARIOS_PERMITIDOS=

# ---------------------------------------------------------------------------
# 3. Direcciones  (al desplegar)
# ---------------------------------------------------------------------------
# Orígenes que pueden llamar a la API, separados por comas.
# Ejemplo: EFA_ORIGENES_CORS=https://tudominio.com
EFA_ORIGENES_CORS=

# A dónde se devuelve al usuario tras entrar con un proveedor externo.
# Ejemplo: EFA_URL_FRONTEND=https://tudominio.com
EFA_URL_FRONTEND=http://localhost:8000

# ---------------------------------------------------------------------------
# 4. Proveedores de acceso  (opcionales; el que no se configure, no se muestra)
# ---------------------------------------------------------------------------
# La URI de retorno que hay que autorizar en cada proveedor se construye sobre
# EFA_URL_FRONTEND (de arriba) + /api/auth/oauth/<proveedor>/callback. Debe
# COINCIDIR EXACTAMENTE con la registrada en el proveedor. En local, con
# EFA_URL_FRONTEND=http://localhost:8000, entra SIEMPRE a la app por
# http://localhost:8000 (no por 127.0.0.1) para que la URI cuadre.
#
# GOOGLE — https://console.cloud.google.com/apis/credentials
#   Crea un "ID de cliente de OAuth 2.0" de tipo "Aplicación web" y añade como
#   URI de redirección autorizado:
#       http://localhost:8000/api/auth/oauth/google/callback   (en local)
#       https://TU-DOMINIO/api/auth/oauth/google/callback       (al desplegar)
EFA_GOOGLE_CLIENT_ID=
EFA_GOOGLE_CLIENT_SECRET=

# MICROSOFT — https://entra.microsoft.com  (Registros de aplicaciones)
#   URI de redirección:
#       https://TU-DOMINIO/api/auth/oauth/microsoft/callback
EFA_MICROSOFT_CLIENT_ID=
EFA_MICROSOFT_CLIENT_SECRET=

# FACEBOOK — https://developers.facebook.com/apps
#   Producto "Inicio de sesión con Facebook". URI de redirección válido:
#       https://TU-DOMINIO/api/auth/oauth/facebook/callback
#   Facebook exige HTTPS salvo en localhost, y revisión de la app para pedir
#   el permiso "email" a usuarios que no sean administradores de la propia app.
EFA_FACEBOOK_CLIENT_ID=
EFA_FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 5. Evaluación con IA de los casos prácticos  (opcional)
# ---------------------------------------------------------------------------
# Sin clave, la corrección usa el evaluador por reglas incluido.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# 6. Datos locales  (opcional)
# ---------------------------------------------------------------------------
# Carpeta donde se guardan los usuarios registrados. Por defecto, "data/"
# junto al proyecto; en la versión portable, "datos_efa" junto al ejecutable.
EFA_DATA_DIR=
