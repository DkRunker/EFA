# Artefactos de empaquetado PyInstaller (se regeneran con Crear_ejecutable.bat)
/build/
/dist/
*.spec

# Entornos y cachés de Python
.venv/
venv/
.efa_venv/
*.egg-info/
__pycache__/
.pytest_cache/

# Configuración local sensible
backend/.env

# Datos locales de la aplicación (usuarios registrados, con sus credenciales)
/data/

# PDF de exámenes: material con derechos, no se versiona
*.pdf

# Banco de preguntas de exámenes y simulacros: se genera a partir de los PDF y
# no se publica. La aplicación funciona sin él (ver backend/database.py), solo
# que con el banco propio y sin las convocatorias oficiales reproducibles.
backend/content/examenes_reales.py

# Casos prácticos resueltos procedentes del libro de exámenes. Los casos de
# elaboración propia sí se versionan (backend/content/practicas.py).
backend/content/practicas_libro.py

# Scratch / temporales
*.log
